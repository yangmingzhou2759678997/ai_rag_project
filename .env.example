# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=
CHAT_MODEL=
OPENAI_TEMPERATURE=0.1

# RAG
EMBEDDING_MODEL=BAAI/bge-m3
CHUNK_SIZE=350
CHUNK_OVERLAP=50
RECALL_TOP_K=10
RERANK_TOP_K=3
RERANK_SCORE_THRESHOLD=0.25

# Reranker
RERANKER_API_URL=https://api.siliconflow.cn/v1/rerank
RERANKER_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=ai_rag
DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:5432/ai_rag

# JWT
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Knowledge Base
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=txt,md,docx,pdf

# External Tool
WEATHER_API_TIMEOUT=10

# CORS
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Logging
LOG_LEVEL=INFO